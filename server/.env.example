# Copy to .env and fill in. Never commit .env.

# "supabase" for real use; "memory" runs with no database (data is lost on restart).
REPOSITORY=supabase

# Supabase project -> Settings -> API. Use the service_role key: it stays on the server only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=manuals

# Where the Next.js client runs (comma separated).
CORS_ORIGINS=http://localhost:3000

MAX_UPLOAD_MB=300

# How headings are found. "openai" asks a model page by page which lines start a heading (it only picks
# line numbers; the node text is always the PDF's own text). "regex" is free and offline.
CHUNK_PLANNER=regex
CHUNK_MODEL=gpt-4.1-mini
# Lines of the previous and next page shown with each page (so a heading cut by a page break reads whole).
CHUNK_CONTEXT_LINES=6

# Finds "see Section X" mentions in each node with OpenAI (needs OPENAI_API_KEY).
REF_EXTRACTOR_MODEL=gpt-4.1-mini
REF_EXTRACTOR_WORKERS=8

# "none" skips vectors (nodes are saved without embeddings). "openai" embeds with the API below.
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=text-embedding-3-small
# Must match vector(N) in sql/schema.sql.
EMBEDDING_DIM=1536
OPENAI_API_KEY=
